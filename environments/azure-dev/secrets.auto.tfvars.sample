# Sample secrets file for the azure-dev environment.
#
# Copy this file to secrets.auto.tfvars (which is gitignored) and replace the
# placeholder values with real ones:
#
#   cp secrets.auto.tfvars.sample secrets.auto.tfvars
#   chmod 600 secrets.auto.tfvars
#
# Terraform loads *.auto.tfvars automatically. This .sample file is NOT loaded
# by Terraform and must never contain real secrets.

# Local administrator password for the Windows VMs.
# Must be at least 12 characters and meet Azure's complexity rules
# (at least 3 of: uppercase, lowercase, digit, special character).
admin_password = "<your strong password>"
